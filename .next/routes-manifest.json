{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/morfo/clientes/[id]",
      "regex": "^/morfo/clientes/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/morfo/clientes/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/morfo/cotizaciones/[id]",
      "regex": "^/morfo/cotizaciones/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/morfo/cotizaciones/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/morfo/gastos/[id]",
      "regex": "^/morfo/gastos/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/morfo/gastos/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/morfo",
      "regex": "^/morfo(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/morfo(?:/)?$"
    },
    {
      "page": "/morfo/ajustes",
      "regex": "^/morfo/ajustes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/morfo/ajustes(?:/)?$"
    },
    {
      "page": "/morfo/clientes/nueva",
      "regex": "^/morfo/clientes/nueva(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/morfo/clientes/nueva(?:/)?$"
    },
    {
      "page": "/morfo/cobros",
      "regex": "^/morfo/cobros(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/morfo/cobros(?:/)?$"
    },
    {
      "page": "/morfo/cotizaciones",
      "regex": "^/morfo/cotizaciones(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/morfo/cotizaciones(?:/)?$"
    },
    {
      "page": "/morfo/cotizaciones/nueva",
      "regex": "^/morfo/cotizaciones/nueva(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/morfo/cotizaciones/nueva(?:/)?$"
    },
    {
      "page": "/morfo/gastos",
      "regex": "^/morfo/gastos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/morfo/gastos(?:/)?$"
    },
    {
      "page": "/morfo/gastos/nuevo",
      "regex": "^/morfo/gastos/nuevo(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/morfo/gastos/nuevo(?:/)?$"
    },
    {
      "page": "/morfo/login",
      "regex": "^/morfo/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/morfo/login(?:/)?$"
    },
    {
      "page": "/morfo/operaciones",
      "regex": "^/morfo/operaciones(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/morfo/operaciones(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}